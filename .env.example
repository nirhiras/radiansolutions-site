# Public address of the site (used in email links). No trailing slash.
SITE_URL=https://www.radiansolutions.com

# Optional: sender for all emails (must be on your verified Resend domain). Default shown.
FROM_EMAIL=Radian Solutions <info@radiansolutions.com>

# Where internal lead alerts go (defaults to info@radiansolutions.com)
LEAD_NOTIFY_EMAIL=info@radiansolutions.com

# Your Ceipal career portal URL (must start with https://). Shown on /join-us.
CEIPAL_CAREER_URL=
