# Copy these into Railway: service > Variables. Never commit real values.

# Resend: the API key, and the domain radiansolutions.com must be verified in Resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Supabase project "RadianSolutions"
SUPABASE_URL=https://imougnqdcbwrhncsavvh.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Long random string used to sign expiring capability-statement download links.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
