{
  "name": "radiansolutions-site",
  "version": "1.0.0",
  "private": true,
  "description": "RadianSolutions.com: static site plus a small API for the contact form and the gated capability statement.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "start:local": "node --env-file=.env server.js",
    "test:email": "node --env-file=.env scripts/send-test-email.js",
    "fetch:logos": "node scripts/fetch-logos.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.21.0",
    "resend": "^4.0.0"
  }
}
